{
  "redirects": [
    {
      "source": "/door-policy/:path*",
      "destination": "/agents",
      "permanent": false
    },
    {
      "source": "/package.json",
      "destination": "/agents",
      "permanent": false
    },
    {
      "source": "/middleware.js",
      "destination": "/agents",
      "permanent": false
    },
    {
      "source": "/skills-lock.json",
      "destination": "/agents",
      "permanent": false
    },
    {
      "source": "/.agents/:path*",
      "destination": "/agents",
      "permanent": false
    },
    {
      "source": "/.claude/:path*",
      "destination": "/agents",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/guestbook/admin",
      "destination": "/api/guestbook-admin"
    },
    {
      "source": "/guestbook/:id",
      "destination": "/api/guestbook?id=:id"
    },
    {
      "source": "/guestbook",
      "destination": "/api/guestbook?go=book"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/profile.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/work/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
